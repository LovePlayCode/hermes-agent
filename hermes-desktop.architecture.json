  "cards": [
    {
      "dot": "cyan",
      "title": "为什么 GUI 能力不能靠 HERMES_DESKTOP 判断",
      "items": [
        "客户端与后端可能是两台机器：本地 Electron、SSH 远端、URL+token、Hermes Cloud",
        "只有前两种由 Electron 拉起并带 HERMES_DESKTOP=1，其余一半拓扑里该 env 键控静默失效",
        "正解：工具集才是能力面开关（desktop_ui / project），由会话自身来源解析，而非后端进程环境"
      ]
    },
    {
      "dot": "violet",
      "title": "进程边界与可信面",
      "items": [
        "主进程：Node 全权限，spawn 后端、管 PTY、管连接与密钥（单实例锁持有者才有权）",
        "渲染进程：无 Node，仅 preload 经 contextBridge 暴露的 hermesDesktop 白名单（约 15 组 API）",
        "IPC：102 处 ipcMain.handle，83 个 hermes:* 命名空间通道",
        "PTY 与浏览器子进程：主要的能力逃逸面，隔离在沙箱域"
      ]
    },
    {
      "dot": "emerald",
      "title": "本地后端如何被拉起",
      "items": [
        "main.ts:12248 startHermes() → spawn hermes serve --host 127.0.0.1 --port 0（端口 0 由系统分配）",
        "端口经 HERMES_DESKTOP_READY_FILE 回传；渲染进程连 ws://127.0.0.1:PORT/api/ws?token=…",
        "HERMES_DESKTOP=1 时后端自行触发 cron（web_server.py:438），不依赖 Electron 侧 ticker"
      ]
    }
  ]
